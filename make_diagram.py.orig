#!/usr/bin/env python3
"""Generate the README architecture diagram, one SVG per colour scheme.

Two files rather than one self-switching file: GitHub strips <style> blocks
from inline SVG, so a `prefers-color-scheme` media query inside the document is
silently dropped. The README pairs them with <picture>, which GitHub honours.

A README diagram is studied, not narrated, so it is COMPLETE rather than
minimal: the boot-time secret read, the optional email path and the agent's
own AWS API access are all on it. Replaces aws-openclaw.drawio, which still
showed the Nova models removed from bedrock-config.sh.

Model names are deliberately NOT drawn. They live in bedrock-config.sh and
change there; a diagram that named them would go stale the same way the old
one did.

Run:  python make_diagram.py
"""

import os

HERE = os.path.dirname(os.path.abspath(__file__))

# ------------------------------------------------------------------------------
# Geometry and style
# ------------------------------------------------------------------------------
# No mobile sizing: this is read on a monitor, at full width in a README.
NW, NH = 400, 110                          # node width, height
GUTTER = 180                               # room for a label plus the EC2 frame
MARGIN = 40
PAD = 24                                   # EC2 frame inset around its column
COL = [MARGIN + i * (NW + GUTTER) for i in range(3)]
ROW = [110, 290, 470, 650]
W = MARGIN * 2 + NW * 3 + GUTTER * 2
H = ROW[3] + NH + 60
TITLE_PX, SUB_PX, EDGE_PX, GROUP_PX = 26, 17, 16, 18

THEMES = {
    "dark": {
        "bg": "#0d1117", "panel": "#161b22", "text": "#e6edf3",
        "muted": "#8b949e", "line": "#58a6ff", "local": "#39c5bb",
        "purple": "#c39be8", "navy": "#c8d6e8", "blue": "#58a6ff",
        "amber": "#f2c163", "store": "#7ee787", "frame": "#3d444d",
    },
    "light": {
        "bg": "#ffffff", "panel": "#f6f8fa", "text": "#1f2328",
        "muted": "#59636e", "line": "#0969da", "local": "#137e77",
        "purple": "#8250df", "navy": "#475467", "blue": "#0969da",
        "amber": "#9a6700", "store": "#1a7f37", "frame": "#d1d9e0",
    },
}

# Lucide icon paths, on a 24-unit grid.
ICONS = {
    "user": ['<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>',
             '<circle cx="12" cy="7" r="4"/>'],
    "package": ['<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73'
                'l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>',
                '<path d="M12 22V12"/>',
                '<path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/>',
                '<path d="m7.5 4.27 9 5.14"/>'],
    "zap": ['<path d="M4 14h7l-1 8 10-12h-7l1-8z"/>'],
    "monitor": ['<rect width="20" height="14" x="2" y="3" rx="2"/>',
                '<line x1="8" x2="16" y1="21" y2="21"/>',
                '<line x1="12" x2="12" y1="17" y2="21"/>'],
    "bot": ['<path d="M12 8V4H8"/>',
            '<rect width="16" height="12" x="4" y="8" rx="2"/>',
            '<path d="M2 14h2"/>', '<path d="M20 14h2"/>',
            '<path d="M15 13v2"/>', '<path d="M9 13v2"/>'],
    "route": ['<circle cx="6" cy="19" r="3"/>', '<circle cx="18" cy="5" r="3"/>',
              '<path d="M12 19h4.5a3.5 3.5 0 0 0 0-7h-8a3.5 3.5 0 0 1 0-7H12"/>'],
    "lock": ['<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>',
             '<path d="M7 11V7a5 5 0 0 1 10 0v4"/>'],
    "cloud": ['<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>'],
    "mail": ['<rect width="20" height="16" x="2" y="4" rx="2"/>',
             '<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>'],
    "cpu": ['<rect width="16" height="16" x="4" y="4" rx="2"/>',
            '<rect width="6" height="6" x="9" y="9" rx="1"/>',
            '<path d="M15 2v2"/>', '<path d="M15 20v2"/>', '<path d="M2 15h2"/>',
            '<path d="M2 9h2"/>', '<path d="M20 15h2"/>', '<path d="M20 9h2"/>',
            '<path d="M9 2v2"/>', '<path d="M9 20v2"/>'],
}

# Left: who connects, and what the host is built from. Middle: the host,
# boot to model call, top to bottom. Right: the AWS services it reaches, each
# level with the component that calls it. Amber goes to one node only: the
# OpenClaw gateway, the agent the project exists to run.
#
# id: (x, y, colour key, icon, title, subtitle)
NODES = {
    "user":     (COL[0], ROW[1], "navy", "user", "You", "any RDP client"),
    "ami":      (COL[0], ROW[3], "navy", "package", "openclaw_ami",
                 "Packer: Ubuntu 24.04 + tools"),
    "boot":     (COL[1], ROW[0], "blue", "zap", "userdata.sh",
                 "first boot: password, LiteLLM, email"),
    "desktop":  (COL[1], ROW[1], "navy", "monitor", "LXQt Desktop",
                 "Chrome, VS Code, OnlyOffice"),
    "gateway":  (COL[1], ROW[2], "amber", "bot", "OpenClaw Gateway",
                 "agent: exec, files, browser"),
    "litellm":  (COL[1], ROW[3], "blue", "route", "LiteLLM Proxy",
                 "one alias per Bedrock model"),
    "secrets":  (COL[2], ROW[0], "store", "lock", "Secrets Manager",
                 "password, SES SMTP credentials"),
    "awsapi":   (COL[2], ROW[1], "blue", "cloud", "AWS APIs",
                 "Cost Explorer and more"),
    "ses":      (COL[2], ROW[2], "blue", "mail", "Amazon SES",
                 "outbound email (optional)"),
    "bedrock":  (COL[2], ROW[3], "purple", "cpu", "Amazon Bedrock",
                 "models from bedrock-config.sh"),
}

FRAME = (COL[1] - PAD, 40, NW + 2 * PAD, ROW[3] + NH + PAD - 40)
FRAME_TITLE = "EC2 · openclaw-host"


def _r(nid):
    """Return (left, top, right, bottom, centre-x, centre-y) for a node."""
    x, y = NODES[nid][0], NODES[nid][1]
    return x, y, x + NW, y + NH, x + NW / 2, y + NH / 2


def _right(a, b):
    """Horizontal hop, a's right edge to b's left edge."""
    return f"M{_r(a)[2]},{_r(a)[5]} L{_r(b)[0] - 5},{_r(b)[5]}"


def _down(a, b):
    """Vertical hop between two nodes sharing a column."""
    x = _r(a)[4]
    return f"M{x},{_r(a)[3]} L{x},{_r(b)[1] - 5}"


def _gutter_up(a, b):
    """Right out of a, up the gutter, right into b (b one row up, next column).

    Turns in the gutter rather than climbing b's column, which would run
    through the box between them.
    """
    gx = _r(b)[0] - GUTTER / 2 + PAD / 2
    return f"M{_r(a)[2]},{_r(a)[5] - 22} H{gx} V{_r(b)[5]} H{_r(b)[0] - 5}"


def _into_frame(a):
    """From a node in the left column to the EC2 frame's left edge."""
    return f"M{_r(a)[2]},{_r(a)[5]} L{FRAME[0] - 5},{_r(a)[5]}"


def gutter_x(c):
    """Centre of the gutter to the right of column c."""
    return COL[c] + NW + GUTTER / 2


def between(a, b):
    """Label baseline centred on a vertical hop between two nodes."""
    return (_r(a)[3] + _r(b)[1]) / 2 + 6


# Horizontal-hop labels sit above their line in the gutter (below it for SES,
# whose "above" is taken by the AWS-API elbow); vertical-hop labels sit left of
# their line. Dashed = optional.
# id: (path, colour key, label, label_x, label_y, anchor, dashed)
EDGES = {
    "e_rdp":     (_right("user", "desktop"), "line", "RDP :3389",
                  gutter_x(0) - PAD / 2, _r("user")[5] - 12, "middle", False),
    "e_ami":     (_into_frame("ami"), "navy", "launched from",
                  gutter_x(0) - PAD / 2, _r("ami")[5] - 12, "middle", False),
    "e_secret":  (_right("boot", "secrets"), "store", "read at boot",
                  gutter_x(1) + PAD / 2, _r("boot")[5] - 12, "middle", False),
    "e_ui":      (_down("desktop", "gateway"), "local", "localhost:18789",
                  _r("desktop")[4] - 16, between("desktop", "gateway"), "end", False),
    "e_llm":     (_down("gateway", "litellm"), "local", "localhost:4000",
                  _r("gateway")[4] - 16, between("gateway", "litellm"), "end", False),
    # Labelled beside its climb, in the gap between AWS APIs and SES: above
    # the short final segment it sat on the vertical line.
    "e_api":     (_gutter_up("gateway", "awsapi"), "blue", "aws CLI, IAM role",
                  _r("awsapi")[0] - GUTTER / 2 + PAD / 2 + 10,
                  between("awsapi", "ses"), "start", False),
    "e_mail":    (_right("gateway", "ses"), "blue", "mail (msmtp)",
                  gutter_x(1) + PAD / 2, _r("ses")[5] + 26, "middle", True),
    "e_bedrock": (_right("litellm", "bedrock"), "purple", "Converse",
                  gutter_x(1) + PAD / 2, _r("litellm")[5] - 12, "middle", False),
}

ALT = ("You connect over RDP to an LXQt desktop on an EC2 instance launched from "
       "a Packer AMI. At first boot userdata.sh reads secrets from Secrets "
       "Manager. Chrome opens the OpenClaw gateway on localhost, which calls "
       "LiteLLM on localhost, which calls Claude models on Amazon Bedrock. The "
       "agent reaches other AWS APIs through the instance IAM role and, "
       "optionally, sends email through Amazon SES")

# ------------------------------------------------------------------------------
# Rendering
# ------------------------------------------------------------------------------
FONT = "-apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif"


def node_svg(nid, t):
    """Render one service box: rounded panel, icon, title, subtitle."""
    x, y, key, icon, title, sub = NODES[nid]
    colour = t[key]
    scale = 1.25
    isz = 24 * scale
    ix, iy = x + 20, y + (NH - isz) / 2
    tx = x + 20 + isz + 14
    return "".join([
        f'<rect x="{x}" y="{y}" width="{NW}" height="{NH}" rx="10" ry="10" '
        f'fill="{t["panel"]}" stroke="{colour}" stroke-width="2"/>',
        f'<g transform="translate({ix},{iy}) scale({scale})" fill="none" '
        f'stroke="{colour}" stroke-width="2" stroke-linecap="round" '
        f'stroke-linejoin="round">' + "".join(ICONS[icon]) + "</g>",
        f'<text x="{tx}" y="{y + NH/2 - 4}" font-family="{FONT}" '
        f'font-size="{TITLE_PX}" font-weight="600" fill="{t["text"]}">{title}</text>',
        f'<text x="{tx}" y="{y + NH/2 + 22}" font-family="{FONT}" '
        f'font-size="{SUB_PX}" fill="{t["muted"]}">{sub}</text>',
    ])


def edge_svg(eid, t):
    """Render one arrow plus its label."""
    d, key, label, lx, ly, anchor, dashed = EDGES[eid]
    colour = t[key]
    dash = ' stroke-dasharray="7 5"' if dashed else ""
    out = (f'<path d="{d}" fill="none" stroke="{colour}" stroke-width="2"{dash} '
           f'marker-end="url(#a_{eid})"/>')
    if label:
        out += (f'<text x="{lx}" y="{ly}" text-anchor="{anchor}" '
                f'font-family="{FONT}" font-size="{EDGE_PX}" font-weight="600" '
                f'fill="{colour}">{label}</text>')
    return out


def frame_svg(t):
    """The EC2 instance: a dashed frame around everything that runs on it."""
    x, y, w, h = FRAME
    return (f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="14" ry="14" '
            f'fill="none" stroke="{t["frame"]}" stroke-width="2" '
            f'stroke-dasharray="8 6"/>'
            f'<text x="{x + w / 2}" y="{y + 42}" text-anchor="middle" '
            f'font-family="{FONT}" font-size="{GROUP_PX}" font-weight="600" '
            f'fill="{t["muted"]}">{FRAME_TITLE}</text>')


def build(t):
    """Assemble the diagram for one theme."""
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" '
           f'viewBox="0 0 {W} {H}" role="img" aria-label="{ALT}">', "<defs>"]
    # One marker per edge: a shared marker cannot carry per-edge colour.
    for eid, spec in EDGES.items():
        out.append(
            f'<marker id="a_{eid}" viewBox="0 0 10 10" refX="9" refY="5" '
            f'markerWidth="5" markerHeight="5" orient="auto-start-reverse">'
            f'<path d="M0,0 L10,5 L0,10 z" fill="{t[spec[1]]}"/></marker>')
    out.append("</defs>")
    out.append(f'<rect width="{W}" height="{H}" fill="{t["bg"]}"/>')
    out.append(frame_svg(t))
    for eid in EDGES:
        out.append(edge_svg(eid, t))
    for nid in NODES:
        out.append(node_svg(nid, t))
    out.append("</svg>")
    return "".join(out)


def main():
    for name, theme in THEMES.items():
        path = os.path.join(HERE, f"architecture-{name}.svg")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(build(theme))
        print(f"  architecture-{name}.svg")


if __name__ == "__main__":
    main()
